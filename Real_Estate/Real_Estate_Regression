import pandas as pd
from sklearn.linear_model import LinearRegression 
from sklearn.metrics import mean_absolute_error
data={"Bedrooms":[2,3,3,4,4,5,5,6],"Square_Feet":[1000,1500,1600,2000,2200,2800,3000,3500],"Price_Dollars":[200000,300000,320000,400000,440000,560000,600000,700000]
 }
df=pd.DataFrame(data)
X=df[["Square_Feet"]]
y=df["Price_Dollars"]
model=LinearRegression()
model.fit(X,y)
 
print("---THE AI's DISCOVERED RULE---")
print("The multiplier(coefficient):",model.coef_[0])
print("The starting price(Intercept):",model.intercept_)
X_test=pd.DataFrame({"Square_Feet":[4000]})
real_price=[800000]
prediction=model.predict(X_test)
print("\n---Grading the REAL ESTATE AI---")
print("AI predicted price:$",prediction[0])
print("Margin of Error(MAE):$",mean_absolute_error(real_price,prediction))
